"""Цветовая схема и стили приложения StudioManager.

Тема: светло-мятная со светло-розовым и светло-жёлтым акцентом.
Шрифт: Nunito (округлый, современный).
"""
import tkinter as tk
from tkinter import ttk


# ─── Название шрифта ────────────────────────────────────────
FONT = "Nunito"


# ─── Цветовая палитра ───────────────────────────────────────
COLORS = {
    # Фоны — светло-мятные
    "bg": "#f0faf6",
    "surface": "#ffffff",
    "surface_alt": "#fef9e7",

    # Боковая панель — светло-жёлтая
    "sidebar_bg": "#fde68a",
    "sidebar_bg_light": "#fef3c7",
    "sidebar_fg": "#78350f",
    "sidebar_fg_muted": "#92400e",

    # ─── СВЕТЛО-РОЗОВЫЙ (основной акцент) ───────────────────
    "primary": "#f9a8d4",
    "primary_hover": "#f472b6",
    "primary_pressed": "#ec4899",
    "primary_fg": "#831843",
    "primary_light": "#fce7f3",

    # ─── Мята (успех) ───────────────────────────────────────
    "accent": "#6ee7b7",
    "accent_hover": "#34d399",
    "accent_light": "#fef9e7",

    # ─── Статусы ────────────────────────────────────────────
    "danger": "#f43f5e",
    "danger_hover": "#e11d48",
    "warning": "#fef08a",            # пастельный жёлтый (для фона)
    "warning_border": "#facc15",     # светло-жёлтый потемнее (для обводки)

    # ─── Текст ──────────────────────────────────────────────
    "text": "#064e3b",
    "text_muted": "#0f766e",
    "text_light": "#6b9d8b",

    # ─── Границы ────────────────────────────────────────────
    "border": "#fde68a",
    "border_strong": "#fcd34d",

    # ─── Строки таблиц ──────────────────────────────────────
    "row_alt": "#fef9e7",

    # ─── Стекло / тени ──────────────────────────────────────
    "shadow": "#fcd34d",
    "glass": "#ffffff",
}


def apply_theme(root: tk.Tk) -> None:
    """Применяет стили ко всему приложению.

    Args:
        root: Корневое окно Tk.
    """
    root.configure(bg=COLORS["bg"])

    style = ttk.Style()
    try:
        style.theme_use("clam")
    except tk.TclError:
        pass

    # ─── Общие настройки ────────────────────────────────────
    style.configure(
        ".",
        font=(FONT, 11),
        background=COLORS["bg"],
        foreground=COLORS["text"],
    )
    style.configure("TFrame", background=COLORS["bg"])
    style.configure(
        "TLabel",
        background=COLORS["bg"],
        foreground=COLORS["text"],
    )

    style.configure(
        "Surface.TFrame",
        background=COLORS["surface"],
        relief="flat",
        borderwidth=0,
    )
    style.configure(
        "Surface.TLabel",
        background=COLORS["surface"],
        foreground=COLORS["text"],
    )

    # ─── Заголовки ──────────────────────────────────────────
    style.configure(
        "Header.TLabel",
        font=(FONT, 24, "bold"),
        foreground=COLORS["text"],
        background=COLORS["bg"],
    )
    style.configure(
        "Subheader.TLabel",
        font=(FONT, 12),
        foreground=COLORS["text_muted"],
        background=COLORS["bg"],
    )

    # ─── Боковая панель ─────────────────────────────────────
    style.configure(
        "Sidebar.TFrame",
        background=COLORS["sidebar_bg"],
        relief="flat",
        borderwidth=0,
    )
    style.configure(
        "SidebarTitle.TLabel",
        font=(FONT, 18, "bold"),
        foreground=COLORS["sidebar_fg"],
        background=COLORS["sidebar_bg"],
        padding=(20, 20),
    )
    style.configure(
        "Sidebar.TButton",
        font=(FONT, 12),
        anchor="w",
        padding=(20, 14),
        borderwidth=0,
        relief="flat",
        background=COLORS["sidebar_bg"],
        foreground=COLORS["sidebar_fg"],
    )
    style.map(
        "Sidebar.TButton",
        background=[
            ("active", COLORS["sidebar_bg_light"]),
            ("pressed", COLORS["primary"]),
        ],
        foreground=[("active", COLORS["sidebar_fg"])],
    )
    style.configure(
        "SidebarActive.TButton",
        font=(FONT, 12, "bold"),
        anchor="w",
        padding=(20, 14),
        borderwidth=0,
        relief="flat",
        background=COLORS["primary"],
        foreground=COLORS["primary_fg"],
    )
    style.map(
        "SidebarActive.TButton",
        background=[
            ("active", COLORS["primary_hover"]),
            ("pressed", COLORS["primary_pressed"]),
        ],
        foreground=[
            ("active", COLORS["primary_fg"]),
            ("pressed", "#ffffff"),
        ],
    )

    # ─── Обычные кнопки ─────────────────────────────────────
    style.configure(
        "TButton",
        font=(FONT, 11),
        padding=(16, 10),
        borderwidth=0,
        relief="flat",
        background=COLORS["primary"],
        foreground=COLORS["primary_fg"],
        focuscolor=COLORS["primary"],
    )
    style.map(
        "TButton",
        background=[
            ("active", COLORS["primary_hover"]),
            ("pressed", COLORS["primary_pressed"]),
            ("disabled", COLORS["border"]),
        ],
        foreground=[
            ("disabled", COLORS["text_light"]),
            ("active", COLORS["primary_fg"]),
            ("pressed", "#ffffff"),
        ],
    )

    # Кнопка-«успех»
    style.configure(
        "Success.TButton",
        background=COLORS["accent"],
        foreground=COLORS["text"],
    )
    style.map(
        "Success.TButton",
        background=[
            ("active", COLORS["accent_hover"]),
            ("pressed", COLORS["accent_hover"]),
        ],
    )

    # Кнопка-«опасность»
    style.configure(
        "Danger.TButton",
        background=COLORS["danger"],
        foreground="#ffffff",
    )
    style.map(
        "Danger.TButton",
        background=[
            ("active", COLORS["danger_hover"]),
            ("pressed", COLORS["danger_hover"]),
        ],
    )

    # Кнопка-«призрак»
    style.configure(
        "Ghost.TButton",
        background=COLORS["surface_alt"],
        foreground=COLORS["text"],
        borderwidth=0,
    )
    style.map(
        "Ghost.TButton",
        background=[
            ("active", COLORS["border"]),
            ("pressed", COLORS["border_strong"]),
        ],
    )

    # ─── Поля ввода ─────────────────────────────────────────
    style.configure(
        "TEntry",
        font=(FONT, 11),
        padding=10,
        fieldbackground=COLORS["glass"],
        foreground=COLORS["text"],
        bordercolor=COLORS["border"],
        lightcolor=COLORS["border"],
        darkcolor=COLORS["border"],
        insertcolor=COLORS["text"],
    )
    style.map(
        "TEntry",
        bordercolor=[("focus", COLORS["primary_pressed"])],
        lightcolor=[("focus", COLORS["primary_pressed"])],
        darkcolor=[("focus", COLORS["primary_pressed"])],
    )

    style.configure(
        "TCombobox",
        padding=8,
        fieldbackground=COLORS["glass"],
        foreground=COLORS["text"],
        arrowcolor=COLORS["text_muted"],
        bordercolor=COLORS["border"],
    )
    style.map(
        "TCombobox",
        fieldbackground=[("readonly", COLORS["glass"])],
        bordercolor=[("focus", COLORS["primary_pressed"])],
    )

    # ─── Таблица ────────────────────────────────────────────
    style.configure(
        "Treeview",
        font=(FONT, 11),
        rowheight=34,
        background=COLORS["glass"],
        fieldbackground=COLORS["glass"],
        foreground=COLORS["text"],
        borderwidth=0,
        relief="flat",
    )
    style.configure(
        "Treeview.Heading",
        font=(FONT, 11, "bold"),
        background=COLORS["accent_light"],
        foreground=COLORS["text"],
        padding=(10, 10),
        borderwidth=0,
        relief="flat",
    )
    style.map(
        "Treeview.Heading",
        background=[("active", COLORS["border"])],
        foreground=[("active", COLORS["text"])],
    )
    style.map(
        "Treeview",
        background=[("selected", COLORS["primary_light"])],
        foreground=[("selected", COLORS["text"])],
    )

    # ─── Разделитель ────────────────────────────────────────
    style.configure(
        "TSeparator",
        background=COLORS["sidebar_bg_light"],
    )

    # ─── LabelFrame ─────────────────────────────────────────
    style.configure(
        "TLabelframe",
        background=COLORS["surface"],
        bordercolor=COLORS["border"],
        relief="flat",
        borderwidth=1,
    )
    style.configure(
        "TLabelframe.Label",
        background=COLORS["surface"],
        foreground=COLORS["text"],
        font=(FONT, 11, "bold"),
    )

    # ─── Checkbutton ────────────────────────────────────────
    style.configure(
        "TCheckbutton",
        background=COLORS["bg"],
        foreground=COLORS["text"],
        font=(FONT, 11),
    )
    style.map(
        "TCheckbutton",
        background=[("active", COLORS["bg"])],
    )
